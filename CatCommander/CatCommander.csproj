<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- Avalonia core -->
        <PackageReference Include="Avalonia" Version="11.3.20" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>

        <!-- MVVM command layer.
          ReactiveUI.Avalonia replaces the deprecated Avalonia.ReactiveUI package
          (no longer maintained). Pinned to the 11.4.x line, which still targets
          Avalonia 11.x - the 12.x/14.x releases require Avalonia 12 core, which
          the vendored TreeDataGrid (Avalonia 11.x API) can't build against.
        -->
        <PackageReference Include="ReactiveUI" Version="23.2.28" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="11.4.13" />

        <!-- global keyboard hook for shortcuts not routable through Avalonia's input pipeline -->
        <PackageReference Include="SharpHook" Version="7.1.3" />

        <!-- config persistence -->
        <PackageReference Include="Tomlyn" Version="2.10.1" />

        <!-- logging -->
        <PackageReference Include="NLog" Version="6.2.0" />

        <!-- ViewModel property-change notification -->
        <PackageReference Include="Metalama.Patterns.Observability" Version="2026.1.25" />

        <!-- composition root for option-2 DI architecture -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\libcat\libcat.csproj" />
        <!--
          Vendored, not a NuGet reference: 11.2.0+ requires a paid Avalonia Accelerate
          license (AVLIC0001 at build time otherwise). This is the last MIT commit -
          see Avalonia.Controls.TreeDataGrid/NOTICE.md for provenance and how to patch
          bugs directly in it.
        -->
        <ProjectReference Include="..\Avalonia.Controls.TreeDataGrid\Avalonia.Controls.TreeDataGrid.csproj" />
    </ItemGroup>

</Project>
