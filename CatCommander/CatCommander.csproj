<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Avalonia core, pinned to 12.x. The vendored TreeDataGrid (see
          Avalonia.Controls.TreeDataGrid/NOTICE.md) was ported to build against this
          version - if you bump past 12.1.1, re-run that port's build check first.
        -->
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <!--
          No dev-tools package referenced: Avalonia.Diagnostics never got a 12.x release
          (Avalonia 12 breaking changes: "Avalonia.Diagnostics removed; replace with
          AvaloniaUI.DiagnosticsSupport"). Skipped for now - add AvaloniaUI.DiagnosticsSupport
          later if F12 dev tools are actually needed; it's unrelated to whether the app builds/runs.
        -->

        <!--
          MVVM command layer. ReactiveUI.Avalonia replaces the deprecated Avalonia.ReactiveUI
          package. Pinned to the 12.x line to match Avalonia core above - avoid 14.7.1, that's
          a bad release on NuGet (its own nuspec metadata points at the unrelated "splat" repo).
        -->
        <PackageReference Include="ReactiveUI" Version="24.1.0" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.1" />

        <!-- global keyboard hook for shortcuts not routable through Avalonia's input pipeline -->
        <PackageReference Include="SharpHook" Version="7.1.3" />

        <!-- config persistence -->
        <PackageReference Include="Tomlyn" Version="2.10.1" />

        <!-- logging -->
        <PackageReference Include="NLog" Version="6.2.0" />

        <!-- ViewModel property-change notification -->
        <PackageReference Include="Metalama.Patterns.Observability" Version="2026.1.25" />

        <!-- composition root for option-2 DI architecture -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\libcat\libcat.csproj" />
        <!--
          Vendored, not a NuGet reference: 11.2.0+ requires a paid Avalonia Accelerate
          license (AVLIC0001 at build time otherwise). This is the last MIT commit -
          see Avalonia.Controls.TreeDataGrid/NOTICE.md for provenance and how to patch
          bugs directly in it.
        -->
        <ProjectReference Include="..\Avalonia.Controls.TreeDataGrid\Avalonia.Controls.TreeDataGrid.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\*.png" />
    </ItemGroup>

</Project>
