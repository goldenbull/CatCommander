<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CatCommander.ViewModels"
             xmlns:view="using:CatCommander.View"
             xmlns:conv="using:CatCommander.Converters"
             x:Class="CatCommander.View.ItemBrowser"
             x:DataType="vm:ItemBrowserViewModel">
    <UserControl.Styles>
        <!-- Active-panel indicator (see MainPanel.axaml for the matching tab-strip tint): the
             address bar gets the classic TC "current directory" navy background instead of a
             border around the whole panel. -->
        <Style Selector="TextBox.active">
            <Setter Property="Background" Value="{DynamicResource TcSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TcActiveAddressTextBrush}" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>

        <!-- Cursor row (TreeDataGridRowSelectionModel's own "current item", moved by arrow keys/
             click - see ItemBrowserViewModel.SetCurrentRow): the active panel gets a pale blue
             highlight (TcCursorBrush) instead of ClassicTheme.axaml's app-wide gray
             (TreeDataGridSelectedCellBackgroundBrush, used for the inactive panel), so it's obvious
             at a glance which panel is actually listening to the keyboard right now.
             Positive-selector-only (no :not()), matching TextBox.active above - keeping both the
             same shape after :not() turned out to not reliably react to Classes.active toggling
             on TreeDataGrid specifically. No text-color override here, unlike the navy selection
             this replaced - TcItemTextBrush's dark green (see ClassicTheme.axaml) reads fine
             against a light background on its own.

             Two layers need the override, not just the cell: TreeDataGridRow's own ControlTheme
             (Themes/Generic.axaml) paints TreeDataGridSelectedCellBackgroundBrush onto its
             PART_CellsPresenter *underneath* the cells, and individual TreeDataGridCells paint the
             same resource again on top when selected - both need to move together, or the
             row-level gray from ClassicTheme.axaml's app-wide default shows through at the seams
             (this is what "the active selection is gray too, but a different gray" looked like). -->
        <Style Selector="TreeDataGrid.active TreeDataGridRow:selected /template/ TreeDataGridCellsPresenter#PART_CellsPresenter">
            <Setter Property="Background" Value="{DynamicResource TcCursorBrush}" />
        </Style>
        <Style Selector="TreeDataGrid.active :is(TreeDataGridCell):selected">
            <Setter Property="Background" Value="{DynamicResource TcCursorBrush}" />
        </Style>

        <!-- Inactive panel's cursor row: back to no background at all, not the framework's own
             app-wide gray (TreeDataGridSelectedCellBackgroundBrush) that Themes/Generic.axaml
             paints on any selected row with no scoping of its own - that gray has nothing to do
             with Classes.active, so simply not matching it (the way the .active rules above just
             don't match while inactive) isn't enough to suppress it; it has to be overridden back
             to Transparent explicitly, same two layers as the .active override above.

             A real Classes.inactive, not a :not(.active) selector - matching TextBox.active/
             TreeDataGrid.active's own positive-selector-only shape (see the comment above): :not()
             was already found not to react reliably to Classes.active toggling on TreeDataGrid
             specifically. Bound via BooleanConverters.Not rather than an XAML "!" prefix, which
             doesn't reliably compose with this ancestor-lookup-plus-cast binding expression. -->
        <Style Selector="TreeDataGrid.inactive TreeDataGridRow:selected /template/ TreeDataGridCellsPresenter#PART_CellsPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TreeDataGrid.inactive :is(TreeDataGridCell):selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Marked rows (Space-toggled multi-selection - ItemBrowserViewModel.ToggleMarkCurrentItem,
             FileItemRow.IsMarked): medium-blue background, Total Commander's own "marked file"
             look - scoped to TreeDataGrid.active for the same reason the cursor styles above are:
             an inactive panel's marked rows would otherwise keep competing for attention while
             the user is working in the *other* panel. Losing that panel's own
             at-a-glance "what's marked here" reminder while it's inactive is the deliberate
             trade-off - IsMarked itself is untouched (Copy/Move/Delete still act on the real marked
             set regardless of which panel is currently active), only the visual goes back to a
             plain, unmarked-looking row.

             This is a Classes.marked selector, not a {Binding IsMarked} Setter like the cursor
             styles above - a bound Setter competing on the *same* property as another Style, tried
             first, doesn't fall through to the lower-priority one when it evaluates to
             AvaloniaProperty.UnsetValue the way an unset *local* value falls through to a style
             default; Avalonia treats whichever Setter wins as the property's only styled
             contributor, so an UnsetValue Setter that wins **clears** the cursor color instead of
             deferring to it (confirmed - it turned every cursor row's background fully transparent,
             even unmarked ones). A class selector sidesteps this: while unmarked, no ".marked" rule
             matches at all, so it contributes nothing and the cursor rules above are untouched; only
             once a row is actually marked does this selector start matching, and being an extra
             class on top of everything else, it outranks the cursor rules' specificity outright.

             ItemBrowser.axaml.cs keeps each realized TreeDataGridRow's "marked" class in sync with
             its FileItemRow's IsMarked (RowPrepared/RowClearing + a PropertyChanged subscription),
             since nothing in this XAML file can address a row control directly - TreeDataGrid
             synthesizes rows from its own template, they're never declared here. -->
        <Style Selector="TreeDataGrid.active TreeDataGridRow.marked /template/ TreeDataGridCellsPresenter#PART_CellsPresenter">
            <Setter Property="Background" Value="{DynamicResource TcMarkedBrush}" />
        </Style>
        <Style Selector="TreeDataGrid.active TreeDataGridRow.marked :is(TreeDataGridCell)">
            <Setter Property="Background" Value="{DynamicResource TcMarkedBrush}" />
        </Style>
        <Style Selector="TreeDataGrid.active TreeDataGridRow.marked TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- A marked row which is also TreeDataGrid's current row gets the stronger navy/white
             treatment. Other marked rows stay light blue, so the cursor remains identifiable
             inside a multi-item selection; all marked rows use white text. -->
        <Style Selector="TreeDataGrid.active TreeDataGridRow.marked:selected /template/ TreeDataGridCellsPresenter#PART_CellsPresenter">
            <Setter Property="Background" Value="{DynamicResource TcCurrentMarkedBrush}" />
        </Style>
        <Style Selector="TreeDataGrid.active TreeDataGridRow.marked:selected :is(TreeDataGridCell)">
            <Setter Property="Background" Value="{DynamicResource TcCurrentMarkedBrush}" />
        </Style>
        <!-- History dropdown (see the Flyout below): compact, square, left-aligned - matching the
             rest of the classic TC chrome instead of Fluent's default roomy/centered ListBox. -->
        <Style Selector="ListBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TcPanelBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TcBorderBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2">
            <TextBox Grid.Column="0"
                     Classes.active="{Binding $parent[view:MainPanel].((vm:MainPanelViewModel)DataContext).IsActive}"
                     Text="{Binding CurrentPath}"
                     PlaceholderText="Path" />

            <!-- Navigation history dropdown - only paths TracksHistory-eligible providers were
                 actually navigated to via NavigateToAsync end up here (see
                 ItemBrowserViewModel.RecordHistory); archive-internal browsing or a future Ctrl+B
                 tree expansion never populate this list. Selecting an entry navigates to it and
                 closes the flyout - see ItemBrowser.axaml.cs's OnHistorySelectionChanged. -->
            <Button x:Name="HistoryButton"
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    Padding="4,2"
                    Content="▼"
                    ToolTip.Tip="Navigation history">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight" Closed="OnHistoryFlyoutClosed">
                        <ListBox x:Name="HistoryList"
                                 ItemsSource="{Binding NavigationHistory}"
                                 SelectionChanged="OnHistorySelectionChanged"
                                 MinWidth="250"
                                 MaxHeight="300" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource TcBorderBrush}">
            <TextBlock Margin="4,2" Text="{Binding SelectionSummary}" />
        </Border>

        <!-- Quick filter bar (Total Commander-style): pops up below the grid the moment the user
             starts typing while FileGrid has focus, and disappears again on Escape/clearing back
             to empty - see ItemBrowser.axaml.cs's OnPreviewTextInput/OnPreviewKeyDown, which
             capture that typing before it reaches TreeDataGrid's own built-in type-ahead-jump
             handling. The TextBox is a display only (IsReadOnly/Focusable=False) - real keyboard
             focus never leaves FileGrid, FilterText is only ever changed via
             ItemBrowserViewModel.AppendFilterText/RemoveLastFilterCharacter/ClearFilter. -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding IsFilterActive}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource TcBorderBrush}">
            <Grid ColumnDefinitions="Auto,*" Margin="2">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="2,0,4,0"
                           Text="Filter:" />
                <TextBox Grid.Column="1"
                         Text="{Binding FilterText, Mode=OneWay}"
                         IsReadOnly="True"
                         Focusable="False" />
            </Grid>
        </Border>

        <!-- TreeDataGrid itself isn't Focusable by default (only its cells are - see
             Avalonia.Controls.TreeDataGrid/Primitives/TreeDataGridCell.cs) - Focusable="True" here
             is what makes FileGrid.Focus() in ItemBrowser.axaml.cs an actual, not silently-no-op,
             focus target, while its own OnKeyDown override still gets arrow-key navigation right
             since it fires for the focused element itself, not just its descendants. -->
        <TreeDataGrid x:Name="FileGrid"
                      Focusable="True"
                      Classes.active="{Binding $parent[view:MainPanel].((vm:MainPanelViewModel)DataContext).IsActive}"
                      Classes.inactive="{Binding $parent[view:MainPanel].((vm:MainPanelViewModel)DataContext).IsActive, Converter={x:Static conv:BooleanConverters.Not}}"
                      Source="{Binding Source}"
                      ShowColumnHeaders="True"
                      CanUserResizeColumns="True" />
    </DockPanel>
</UserControl>
