<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CatCommander.ViewModels"
             x:Class="CatCommander.View.ItemBrowser"
             x:DataType="vm:ItemBrowserViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2">
            <TextBox Grid.Column="0"
                     Text="{Binding CurrentPath}"
                     PlaceholderText="Path" />
            <Button Grid.Column="1"
                    Margin="4,0,0,0"
                    Content="{Binding ViewMode}"
                    Command="{Binding ToggleViewModeCommand}" />
        </Grid>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemBaseLowColor}">
            <TextBlock Margin="4,2" FontSize="11" Text="{Binding SelectionSummary}" />
        </Border>

        <TreeDataGrid Source="{Binding Source}"
                      ShowColumnHeaders="True"
                      CanUserResizeColumns="True" />
    </DockPanel>
</UserControl>
