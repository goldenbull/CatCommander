<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CatCommander.ViewModels"
        xmlns:view="using:CatCommander.View"
        x:Class="CatCommander.View.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CatCommander"
        Icon="/Assets/cat.png"
        Width="1024"
        Height="640"
        WindowState="Maximized">

    <!--
      One NativeMenu model drives both platforms: on macOS it becomes the system menu bar (via
      NativeMenu.Menu below), and the NativeMenuBar control placed in the tree further down
      renders it as an in-window bar on Windows/Linux (and is a no-op on macOS) - no need to
      define the menu twice.
    -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenu>
                    <NativeMenuItem Header="Find..." Command="{Binding OpenFindCommand}" Icon="/Assets/Icons/find.png" />
                    <NativeMenuItem Header="Batch Rename..." Command="{Binding OpenBatchRenameCommand}" Icon="/Assets/Icons/batch_rename.png" />
                    <NativeMenuItem Header="File Operations..." Command="{Binding OpenJobListCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <!--
              Gesture= deliberately not set here - MainWindow.axaml.cs's ApplyMenuGestures sets it
              from ShortcutsSettings.GetPrimaryGesture at runtime instead of a hardcoded string, so
              the menu's displayed/native-active shortcut can never drift from what a real keypress
              would actually dispatch through ShortcutRouter (or from a user's keymap.toml override).
            -->
            <NativeMenuItem Header="Edit">
                <NativeMenu>
                    <NativeMenuItem Header="Copy" Command="{Binding CopyCommand}" Icon="/Assets/Icons/copy.png" />
                    <NativeMenuItem Header="Move" Command="{Binding MoveCommand}" Icon="/Assets/Icons/move.png" />
                    <NativeMenuItem Header="Rename" Command="{Binding RenameCommand}" Icon="/Assets/Icons/rename.png" />
                    <NativeMenuItem Header="Delete" Command="{Binding DeleteCommand}" Icon="/Assets/Icons/delete.png" />
                    <NativeMenuItem Header="New Folder" Command="{Binding OpenCreateDirectoryDialogCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Settings">
                <NativeMenu>
                    <NativeMenuItem Header="Restore Default Shortcuts" Command="{Binding RestoreDefaultShortcutsCommand}" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel LastChildFill="True">
        <NativeMenuBar DockPanel.Dock="Top" />

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" BorderThickness="0" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="26" />
                        <Setter Property="Padding" Value="5" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource TcCursorBrush}" />
                    </Style>
                    <Style Selector="Button Image">
                        <Setter Property="Width" Value="16" />
                        <Setter Property="Height" Value="16" />
                    </Style>
                    <Style Selector="Button PathIcon">
                        <Setter Property="Width" Value="16" />
                        <Setter Property="Height" Value="16" />
                        <Setter Property="Foreground" Value="{DynamicResource TcTextBrush}" />
                    </Style>
                </StackPanel.Styles>

                <Button Command="{Binding CopyCommand}" ToolTip.Tip="Copy (F5)">
                    <Image Source="/Assets/Icons/copy.png" />
                </Button>
                <Button Command="{Binding MoveCommand}" ToolTip.Tip="Move (F6)">
                    <Image Source="/Assets/Icons/move.png" />
                </Button>
                <Button Command="{Binding RenameCommand}" ToolTip.Tip="Rename (F2)">
                    <Image Source="/Assets/Icons/rename.png" />
                </Button>
                <Button Command="{Binding DeleteCommand}" ToolTip.Tip="Delete (F8)">
                    <Image Source="/Assets/Icons/delete.png" />
                </Button>
                <Button Command="{Binding OpenCreateDirectoryDialogCommand}" ToolTip.Tip="New Folder (F7)">
                    <PathIcon Data="M2,5 L8,5 L10,7 L22,7 L22,20 L2,20 Z" />
                </Button>

                <Button Command="{Binding OpenFindCommand}" ToolTip.Tip="Find (Alt+F7)">
                    <Image Source="/Assets/Icons/find.png" />
                </Button>
                <Button Command="{Binding OpenBatchRenameCommand}" ToolTip.Tip="Batch Rename">
                    <Image Source="/Assets/Icons/batch_rename.png" />
                </Button>
                <Button Command="{Binding OpenJobListCommand}" ToolTip.Tip="File Operations">
                    <PathIcon Data="M3,4 L21,4 L21,7 L3,7 Z M3,10 L21,10 L21,13 L3,13 Z M3,16 L21,16 L21,19 L3,19 Z" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Main panes - fixed 1:1 split, no draggable splitter. -->
        <Grid Margin="4" ColumnDefinitions="*,4,*">
            <view:MainPanel Grid.Column="0" DataContext="{Binding LeftPanel}" />
            <!-- Just a spacing gap now, not a divider line - each TreeDataGrid already draws its
                 own 1px border (see ClassicTheme.axaml), so a second gray line here was redundant. -->
            <Border Grid.Column="1" Background="Transparent" />
            <view:MainPanel Grid.Column="2" DataContext="{Binding RightPanel}" />
        </Grid>
    </DockPanel>
</Window>
