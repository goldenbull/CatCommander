<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CatCommander.ViewModels"
             xmlns:qa="using:CatCommander.QuickAccess"
             xmlns:conv="using:CatCommander.Converters"
             xmlns:view="using:CatCommander.View"
             x:Class="CatCommander.View.MainPanel"
             x:DataType="vm:MainPanelViewModel"
             Focusable="True">
    <UserControl.Styles>
        <!-- Tab-header buttons - not a TabControl (see MainPanelViewModel's doc comment for why):
             unselected headers blend into the panel; the selected tab alone gets a pale-blue
             background, independent of which side currently owns keyboard focus. -->
        <Style Selector="Button.tabHeader">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource TcBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource TcPanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TcTextBrush}" />
        </Style>
        <Style Selector="Button.tabHeader.selected">
            <Setter Property="Background" Value="{DynamicResource TcCursorBrush}" />
        </Style>
        <Style Selector="Button.tabHeader.selected.panelActive">
            <Setter Property="Background" Value="{DynamicResource TcCursorBrush}" />
        </Style>
        <Style Selector="Button.panelCommand">
            <Setter Property="Background" Value="{DynamicResource TcPanelBrush}" />
        </Style>
        <Style Selector="Button.driveItem">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.driveItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource TcCursorBrush}" />
        </Style>
        <!-- The favorites popup behaves like a native menu: one focusable vertical list,
             arrow-key navigation, and a subtle surface color to delimit the popup. -->
        <Style Selector="ListBox.favoriteMenu">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource TcMenuBrush}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.favoriteMenu ListBoxItem">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.favoriteMenu ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource TcCursorBrush}" />
        </Style>
        <Style Selector="ListBox.favoriteMenu ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource TcCursorBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TcTextBrush}" />
        </Style>
        <Style Selector="Button.favoriteAction">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.favoriteAction:pointerover">
            <Setter Property="Background" Value="{DynamicResource TcCursorBrush}" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TcMenuBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Background="Transparent" (not left null) is required for the interior to be hit-test
         visible at all - otherwise clicks inside it don't register as hitting this control. -->
    <Border Background="{DynamicResource TcPanelBrush}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Background="{DynamicResource TcPanelBrush}">
                <Button x:Name="FavoritesButton"
                        DockPanel.Dock="Left"
                        Classes="panelCommand"
                        Margin="1"
                        Content="★"
                        ToolTip.Tip="Directory favorites (Cmd/Ctrl+D)">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                Opened="OnFavoritesOpened">
                            <Border Background="{DynamicResource TcMenuBrush}" Padding="2">
                                <StackPanel MinWidth="280">
                                    <ListBox x:Name="FavoritesList"
                                             Classes="favoriteMenu"
                                             ItemsSource="{Binding FavoriteMenuEntries}"
                                             SelectionMode="Single"
                                             KeyDown="OnFavoritesKeyDown"
                                             PointerReleased="OnFavoritePointerReleased">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FavoriteMenuItem">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           ToolTip.Tip="{Binding Path}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ItemsControl ItemsSource="{Binding QuickAccessEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="qa:QuickAccessEntry">
                        <Button Margin="1" Classes="driveItem"
                                Command="{Binding $parent[ItemsControl].((vm:MainPanelViewModel)DataContext).NavigateToQuickAccessCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding Path}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Kind, Converter={x:Static conv:QuickAccessKindToGlyphConverter.Instance}}" />
                                <TextBlock Text="{Binding DisplayName}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- One row of tab-header buttons, driving which Tabs entry ItemBrowser below displays -
                 see MainPanelViewModel's doc comment for why this isn't a TabControl. -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemBrowserViewModel">
                        <Button Classes="tabHeader"
                                Classes.selected="{Binding IsActiveTab}"
                                Classes.panelActive="{Binding $parent[ItemsControl].((vm:MainPanelViewModel)DataContext).IsActive}"
                                Content="{Binding CurrentPath}"
                                Command="{Binding $parent[ItemsControl].((vm:MainPanelViewModel)DataContext).SelectTabCommand}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Permanent, never recreated - see MainPanelViewModel's doc comment. Switching tabs
                 only ever rebinds DataContext here. -->
            <view:ItemBrowser DataContext="{Binding ActiveTab}" />
        </DockPanel>
    </Border>
</UserControl>
